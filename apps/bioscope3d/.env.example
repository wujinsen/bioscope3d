# BioScope3D — environment template
# Copy to .env.local and fill in. All vars MUST be prefixed with VITE_ to be exposed to the browser.

# Asset CDN (defaults to /assets locally)
VITE_ASSET_BASE=

# Analytics (optional)
VITE_PLAUSIBLE_DOMAIN=

# Feature flags
VITE_ENABLE_TIMELINE=true
VITE_ENABLE_QUIZ=true
VITE_ENABLE_CLIPPING=true
